# Jager Google Workspace MCP — homeschool-first starter template
# Copy to .env and fill in the Google OAuth values before first real auth test.

# --- Required Google OAuth credentials ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Transport / local auth defaults ---
WORKSPACE_MCP_TRANSPORT=stdio
OAUTHLIB_INSECURE_TRANSPORT=1

# --- Jager homeschool-first defaults ---
# These are now also the code defaults in this fork, but keeping them explicit in
# the env file makes the startup intent obvious.
WORKSPACE_MCP_TOOLS=drive,docs,sheets,slides,forms
WORKSPACE_MCP_TOOL_TIER=core

# --- Credential storage ---
# Override only if you want tokens somewhere custom.
# WORKSPACE_MCP_CREDENTIALS_DIR=~/.google_workspace_mcp/credentials

# --- Optional single-user hint ---
# Set only if you want a default account hint during local auth.
# USER_GOOGLE_EMAIL=hancocksusan123@gmail.com

# --- Optional safety mode ---
# Uncomment to force read-only testing first.
# WORKSPACE_MCP_READ_ONLY=true
